diff --git a/plugins/gobject/ww-shadow-paintable.c b/plugins/gobject/ww-shadow-paintable.c
--- a/plugins/gobject/ww-shadow-paintable.c
+++ b/plugins/gobject/ww-shadow-paintable.c
@@ -1,5 +1,6 @@
 #define _GNU_SOURCE
 #include "ww-shadow-paintable.h"
+#include "ww-display.h"
 
 #include <graphene.h>
 #include <gtk/gtk.h>
@@ -306,4 +307,28 @@ void ww_shadow_paintable_clear(WwShadowPaintable* self) {
     self->clear[2]  = 0.0f;
     self->clear[3]  = 1.0f;
     gdk_paintable_invalidate_contents(GDK_PAINTABLE(self));
 }
+
+gboolean
+ww_shadow_paintable_set_shadow_from_display(WwShadowPaintable* self,
+                                            WwDisplay*         display,
+                                            guint              width,
+                                            guint              height,
+                                            guint              fourcc)
+{
+    gint fd;
+    guint n_planes;
+    guint strides[4];
+    guint64 offsets[4];
+    guint64 modifier;
+
+    g_return_val_if_fail(WW_IS_SHADOW_PAINTABLE(self), FALSE);
+    g_return_val_if_fail(display != NULL, FALSE);
+
+    if (!ww_display_get_shadow_export(display, &fd, &n_planes, strides, offsets, &modifier)) {
+        return FALSE;
+    }
+
+    gboolean res = ww_shadow_paintable_set_shadow(self, fd, n_planes, width, height, fourcc, modifier, strides, offsets);
+    return res;
+}
diff --git a/plugins/gobject/ww-shadow-paintable.h b/plugins/gobject/ww-shadow-paintable.h
--- a/plugins/gobject/ww-shadow-paintable.h
+++ b/plugins/gobject/ww-shadow-paintable.h
@@ -83,2 +83,23 @@ void ww_shadow_paintable_set_composition(WwShadowPaintable* self, double sx, dou
                                         guint transform, double cr, double cg, double cb,
                                         double ca);
+
+typedef struct _WwDisplay WwDisplay;
+
+/**
+ * ww_shadow_paintable_set_shadow_from_display:
+ * @self: a #WwShadowPaintable
+ * @display: a #WwDisplay
+ * @width: image width in pixels
+ * @height: image height in pixels
+ * @fourcc: DRM fourcc
+ *
+ * Query the shadow descriptor from @display and bind the paintable.
+ * This avoids GJS double-to-uint64 rounding issues on modifiers.
+ *
+ * Returns: TRUE on success
+ */
+gboolean ww_shadow_paintable_set_shadow_from_display(WwShadowPaintable* self,
+                                                     WwDisplay*         display,
+                                                     guint              width,
+                                                     guint              height,
+                                                     guint              fourcc);
